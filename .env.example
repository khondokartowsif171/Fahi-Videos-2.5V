# Copy to .env.local. Never commit actual credentials.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Supabase Cloud Project Configuration (Optional - defaults are built-in)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
STUDIO_DATABASE_URL=postgresql://postgres:your_db_password@db.your-project.supabase.co:5432/postgres

# MCP Access Control (Optional - leave empty for open local/public access)
MCP_SECRET_TOKEN=

# Optional model overrides (requires access on your Gemini account)
AURA_TEXT_MODEL=gemini-2.5-flash
AURA_IMAGE_MODEL=gemini-3.1-flash-image-preview
AURA_VIDEO_MODEL=veo-3.1-generate-preview
AURA_TTS_MODEL=gemini-2.5-flash-preview-tts

# Node server needs writable persistent storage for jobs and lead records.
AURA_DATA_DIR=.aura-data

# Leave empty to use ffmpeg on PATH.
FFMPEG_PATH=

# Optional phone integration: configure a real deployed TwiML/agent webhook.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VOICE_WEBHOOK_URL=
